# Leave empty to use the Vite proxy to http://localhost:5001
VITE_API_URL=
# Optional: set true to require login for customer account/checkout pages
VITE_REQUIRE_AUTH=true
# Optional backend target if your Express server runs elsewhere
# VITE_PROXY_TARGET=http://localhost:5001
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com