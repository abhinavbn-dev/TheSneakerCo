# Copy to .env and fill in your own values. Never commit .env.
PORT=5001
# Local MongoDB example:
MONGO_URI=mongodb://127.0.0.1:27017/sneakerco
# Or your private Atlas connection string. URL-encode special characters in passwords.
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=generate-a-random-secret-with-node-crypto
CLIENT_URL=http://localhost:5173,http://localhost:5174
GOOGLE_CLIENT_ID=
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# SMTP is required for customer email OTP registration. Ethereal is for development previews only.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=The Sneaker Co. <your-ethereal-user@ethereal.email>
NODE_ENV=development
